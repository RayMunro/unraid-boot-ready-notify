<FILE Name="&emhttp;/README.md" Mode="0644">
<INLINE><![CDATA[
# Boot Ready Notify

Sends a **Warning-level Unraid notification** once the server has completed Unraid's native `started` event and the Docker daemon is responsive.

The notification is sent through Unraid's own notification subsystem and is limited to one successful notification per OS boot.

Version 2026.09.02f also verifies its Plugin Manager registration and custom PNG icon metadata after Unraid completes the native install registration step.

Copyright © Ray Munro 2026. All rights reserved.
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/event/started" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
PLUGIN_DIR="/usr/local/emhttp/plugins/boot.ready.warning"
LOG="/var/log/boot-ready-warning.log"

if [[ ! -x "$PLUGIN_DIR/scripts/boot-ready-worker" ]]; then
  logger -t boot-ready-warning "worker missing: $PLUGIN_DIR/scripts/boot-ready-worker"
  exit 0
fi

nohup "$PLUGIN_DIR/scripts/boot-ready-worker" >>"$LOG" 2>&1 </dev/null &
exit 0
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/scripts/boot-ready-worker" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
set -u

PLUGIN="boot.ready.warning"
RUN_DIR="${BOOT_READY_RUN_DIR:-/run/$PLUGIN}"
MARKER="$RUN_DIR/notified"
LOCK_DIR="$RUN_DIR/worker.lock"
DOCKER_SOCKET="${BOOT_READY_DOCKER_SOCKET:-/var/run/docker.sock}"
DOCKER_CMD="${BOOT_READY_DOCKER_CMD:-/usr/bin/docker}"
NOTIFY_CMD="${BOOT_READY_NOTIFY_CMD:-/usr/local/emhttp/webGui/scripts/notify}"
DOCKER_CFG="${BOOT_READY_DOCKER_CFG:-/boot/config/docker.cfg}"
WAIT_SECONDS="${BOOT_READY_WAIT_SECONDS:-600}"
POLL_SECONDS="${BOOT_READY_POLL_SECONDS:-2}"
HOST="$(hostname -s 2>/dev/null || hostname)"

mkdir -p "$RUN_DIR"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT

[[ -e "$MARKER" ]] && exit 0

if [[ -r "$DOCKER_CFG" ]]; then
  docker_enabled="$(awk -F'=' '/^DOCKER_ENABLED=/{gsub(/["\047[:space:]]/,"",$2); print tolower($2); exit}' "$DOCKER_CFG" 2>/dev/null)"
  if [[ -n "$docker_enabled" && "$docker_enabled" != "yes" ]]; then
    logger -t boot-ready-warning "Unraid started event received, but Docker is disabled; no ready notification sent"
    exit 0
  fi
fi

logger -t boot-ready-warning "Unraid started event received; waiting for Docker readiness"

deadline=$(( $(date +%s) + WAIT_SECONDS ))
docker_ready=0
while (( $(date +%s) <= deadline )); do
  if [[ -S "$DOCKER_SOCKET" && -x "$DOCKER_CMD" ]] && "$DOCKER_CMD" info >/dev/null 2>&1; then
    docker_ready=1
    break
  fi
  sleep "$POLL_SECONDS"
done

if (( docker_ready != 1 )); then
  logger -t boot-ready-warning "Docker did not become ready within ${WAIT_SECONDS}s; no ready notification sent"
  exit 0
fi

if [[ ! -x "$NOTIFY_CMD" ]]; then
  logger -t boot-ready-warning "Unraid notify command not found: $NOTIFY_CMD"
  exit 0
fi

uptime_seconds="$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)"
if [[ "$uptime_seconds" =~ ^[0-9]+$ ]]; then
  mins=$((uptime_seconds / 60))
  if (( mins >= 60 )); then
    uptime_text="$((mins / 60))h $((mins % 60))m"
  else
    uptime_text="${mins}m"
  fi
else
  uptime_text="unknown"
fi

subject="${HOST} is ready"
description="Unraid has finished starting and Docker is up and running. Boot readiness confirmed after ${uptime_text}."

if "$NOTIFY_CMD" \
  -e "Server Ready" \
  -s "$subject" \
  -d "$description" \
  -i warning \
  -l "/Main"; then
  : > "$MARKER"
  logger -t boot-ready-warning "Warning-level ready notification sent for this boot"
else
  logger -t boot-ready-warning "Unraid notify command returned an error"
  exit 1
fi
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/scripts/test-notification" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
NOTIFY="/usr/local/emhttp/webGui/scripts/notify"
HOST="$(hostname -s 2>/dev/null || hostname)"

if [[ ! -x "$NOTIFY" ]]; then
  echo "Unraid notify command was not found: $NOTIFY" >&2
  exit 1
fi

exec "$NOTIFY" \
  -e "Server Ready Test" \
  -s "$HOST boot-ready warning test" \
  -d "This is a Warning-level test from Boot Ready Notify." \
  -i warning \
  -l "/Settings/Notifications"
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/scripts/finalize-install" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
set -u

PLUGIN_ID="boot.ready.warning"
CANONICAL="boot.ready.warning.plg"
PERSISTENT="/boot/config/plugins/${CANONICAL}"
REGISTRATION="/var/log/plugins/${CANONICAL}"
ICON_NAME="boot.ready.warning.png"
ICON_FILE="/usr/local/emhttp/plugins/${PLUGIN_ID}/images/${ICON_NAME}"
PLUGIN_CMD="/usr/local/sbin/plugin"
STALE_DIR="/boot/config/plugins-stale"

# The Unraid plugin manager executes the plugin's install payload BEFORE it
# copies the new .plg to /boot/config/plugins and creates its registration
# symlink. Give the manager time to finish its native registration first.
sleep 2

for _ in $(seq 1 20); do
  [[ -f "$PERSISTENT" ]] && break
  sleep 0.5
done

if [[ ! -f "$PERSISTENT" ]]; then
  logger -t boot-ready-warning "post-install check: persistent plugin file not found"
  exit 0
fi

# Force the persistent definition to reference the custom PNG. This also
# repairs a stale older definition if one was accidentally copied from a Mac
# Downloads folder under the same canonical filename.
if grep -q 'icon="[^"]*"' "$PERSISTENT"; then
  sed -i '0,/<PLUGIN /s/icon="[^"]*"/icon="boot.ready.warning.png"/' "$PERSISTENT"
else
  sed -i '0,/<PLUGIN /s/>/ icon="boot.ready.warning.png">/' "$PERSISTENT"
fi

mkdir -p /var/log/plugins "$STALE_DIR"

# Remove any duplicate registrations for the same internal plugin identity.
for link in /var/log/plugins/*.plg; do
  [[ -e "$link" || -L "$link" ]] || continue
  [[ "$link" == "$REGISTRATION" ]] && continue
  target="$(readlink "$link" 2>/dev/null || true)"
  [[ -n "$target" && -f "$target" ]] || continue
  name="$($PLUGIN_CMD name "$target" 2>/dev/null || true)"
  if [[ "$name" == "$PLUGIN_ID" ]]; then
    rm -f "$link"
  fi
done

# Move duplicate persistent definitions aside so an older copy cannot run on
# the next boot and put old metadata back into Plugin Manager.
for file in /boot/config/plugins/*.plg; do
  [[ -f "$file" ]] || continue
  [[ "$file" == "$PERSISTENT" ]] && continue
  name="$($PLUGIN_CMD name "$file" 2>/dev/null || true)"
  if [[ "$name" == "$PLUGIN_ID" ]]; then
    base="$(basename "$file")"
    mv -f "$file" "$STALE_DIR/${base}.duplicate-boot-ready"
  fi
done

rm -f "$REGISTRATION"
ln -s "$PERSISTENT" "$REGISTRATION"

mkdir -p "$(dirname "$ICON_FILE")"
chmod 0755 "$(dirname "$ICON_FILE")" 2>/dev/null || true
chmod 0644 "$ICON_FILE" 2>/dev/null || true

logger -t boot-ready-warning "post-install check: PNG icon metadata and plugin registration verified"
exit 0
]]></INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
set -e
chmod 0755 /usr/local/emhttp/plugins/boot.ready.warning/event/started
chmod 0755 /usr/local/emhttp/plugins/boot.ready.warning/scripts/boot-ready-worker
chmod 0755 /usr/local/emhttp/plugins/boot.ready.warning/scripts/test-notification
chmod 0755 /usr/local/emhttp/plugins/boot.ready.warning/scripts/finalize-install

# Unraid itself copies/registers the .plg after this install payload returns.
# Run the final consistency check in the background so it executes afterwards.
nohup /usr/local/emhttp/plugins/boot.ready.warning/scripts/finalize-install \
  >/tmp/boot.ready.warning-finalize.log 2>&1 </dev/null &

if [ -x /usr/local/emhttp/webGui/scripts/notify ]; then
  /usr/local/emhttp/webGui/scripts/notify init >/dev/null 2>&1 || true
fi

]]></INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
echo ""
echo "=============================================================="
echo " Boot Ready Notify &version; installed successfully."
echo " Internal ID: boot.ready.warning"
echo " Severity:    WARNING"
echo " Trigger:     Unraid native 'started' event"
echo " Docker gate: docker info must succeed"
echo "=============================================================="
echo ""
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
pkill -f '/usr/local/emhttp/plugins/boot.ready.warning/scripts/boot-ready-worker' 2>/dev/null || true
rm -rf /usr/local/emhttp/plugins/boot.ready.warning
rm -rf /run/boot.ready.warning
rm -f /var/log/boot-ready-warning.log
rm -f /var/log/plugins/boot.ready.warning.plg
echo "Boot Ready Notify (warning build) removed."
]]></INLINE>
</FILE>

</PLUGIN>
